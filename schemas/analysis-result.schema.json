{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/sirr/analysis-result.schema.json",
  "title": "SIRR Analysis Result",
  "type": "object",
  "required": ["version", "case_digest", "decision", "signals", "worlds", "interventions", "repair_card", "invariants"],
  "properties": {
    "version": {"type": "string"},
    "case_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "signals": {"type": "object"},
    "worlds": {"type": "array"},
    "interventions": {"type": "array"},
    "repair_card": {"type": "object"},
    "invariants": {"type": "object"}
  }
}
