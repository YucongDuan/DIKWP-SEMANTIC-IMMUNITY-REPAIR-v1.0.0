{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/sirr/semantic-case.schema.json",
  "title": "SIRR Semantic Case",
  "type": "object",
  "required": ["text"],
  "properties": {
    "text": {"type": "string", "minLength": 1},
    "domain": {"type": "string"},
    "content_role": {"type": "string"},
    "channel": {"type": "string"},
    "audience_context": {"type": "array", "items": {"type": "string"}},
    "monetized": {"type": "boolean"},
    "paid_funnel": {"type": "boolean"},
    "evidence_quality": {"type": "number", "minimum": 0, "maximum": 1},
    "source_traceability": {"type": "number", "minimum": 0, "maximum": 1},
    "reach": {"type": "number", "minimum": 0, "maximum": 1},
    "repetition": {"type": "number", "minimum": 0, "maximum": 1},
    "ai_origin": {"type": "string"},
    "addictive_features": {"type": "array", "items": {"type": "string"}},
    "verified_fabrication": {"type": "boolean"},
    "verified_harm": {"type": "boolean"},
    "imminent_harm_or_illegal": {"type": "boolean"},
    "authorized_human_review": {"type": "boolean"},
    "appeal_available": {"type": "boolean"}
  },
  "additionalProperties": true
}
